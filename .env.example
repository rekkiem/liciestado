# ══════════════════════════════════════════════════════════
# LiciEstado v1 — Variables de entorno
# cp .env.example .env  →  editar con tus valores reales
# ══════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────
# Local / tests: SQLite
DATABASE_URL=sqlite:///./mercadopublico.db
# Docker Compose default (docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://mp_user:mp_pass@db:5432/mp_alertas
# POSTGRES_DB=mp_alertas
# POSTGRES_USER=mp_user
# POSTGRES_PASSWORD=mp_pass
# POSTGRES_PORT=5432

# ── Cifrado (OBLIGATORIO — genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# ── Flask ───────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
PORT=5000

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=tu@gmail.com
SMTP_USE_TLS=true

# ── Notificaciones admin ───────────────────────────────────────
ADMIN_EMAIL=admin@tudominio.cl

# ── API Mercado Público (fallback global, opcional) ────────────
# Cada usuario ingresa su propio ticket desde el dashboard.
# Este valor se usa solo si no hay ticket por usuario.
TICKET_MERCADO_PUBLICO=

# ── API rate limits ──────────────────────────────────────────
API_RATE_PER_SECOND=5
API_ENRICH_RATE_PER_SECOND=2
API_RATE_PER_DAY=10000
API_MAX_RETRIES=5
API_CIRCUIT_BREAKER_THRESHOLD=3
API_CIRCUIT_BREAKER_PAUSE_SEC=900
